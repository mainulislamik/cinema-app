{
  "expo": {
    "name": "Cinema",
    "slug": "cinema",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imon.cinema"
    },
    "android": {
      "versionCode": 6,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#020617"
      },
      "package": "com.imon.cinema",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/5edbe0f6-4161-4be1-9f14-05af771423f8"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "defaultApiUrl": "http://169.40.116.114:8099",
      "offlineFallback": true,
      "eas": {
        "projectId": "5edbe0f6-4161-4be1-9f14-05af771423f8"
      }
    },
    "owner": "mainulislamik",
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ]
    ]
  }
}
