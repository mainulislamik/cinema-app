{
  "expo": {
    "name": "Cinema",
    "slug": "cinema",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imon.cinema"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#020617"
      },
      "package": "com.imon.cinema",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "extra": {
      "defaultApiUrl": "http://192.168.100.13:8099",
      "offlineFallback": true,
      "eas": {
        "projectId": "5edbe0f6-4161-4be1-9f14-05af771423f8"
      }
    },
    "owner": "mainulislamik"
  }
}
