{
  "expo": {
    "name": "Cinama",
    "slug": "cinema",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imon.cinema"
    },
    "android": {
      "versionCode": 11,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#020617"
      },
      "package": "com.imon.cinema",
      "permissions": [
        "INTERNET",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "VIBRATE",
        "SYSTEM_ALERT_WINDOW",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/5edbe0f6-4161-4be1-9f14-05af771423f8"
    },
    "runtimeVersion": "1.0.0",
    "extra": {
      "defaultApiUrl": "https://cinama.xyz",
      "offlineFallback": true,
      "eas": {
        "projectId": "5edbe0f6-4161-4be1-9f14-05af771423f8"
      }
    },
    "owner": "mainulislamik",
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-ignorewarnings\n-dontwarn expo.modules.**\n-dontwarn com.facebook.react.**\n-keep class expo.modules.** { *; }",
            "extraGradleProperties": {
              "org.gradle.jvmargs": "-Xmx4096m -XX:MaxMetaspaceSize=1536m"
            }
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-web-browser"
    ]
  }
}
